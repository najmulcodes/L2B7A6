# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# ── Database (PostgreSQL via Prisma) ────────────────────────────────────────
# Local:    postgresql://user:password@localhost:5432/devassess?schema=public
# Neon/Supabase pooled connection strings both work with Prisma 5.
DATABASE_URL="postgresql://user:password@localhost:5432/devassess?schema=public"
# Only required if your provider uses a separate non-pooled connection for migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/devassess?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace-with-a-long-random-string-min-16-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Password hashing ─────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── Google OAuth (Sign in with Google) ──────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Redis (caching, rate limiting, locks) ───────────────────────────────
# App runs fine locally without this set — features degrade gracefully.
REDIS_URL="redis://default:password@localhost:6379"

# ── Stripe (payment integration) ────────────────────────────────────────
# Use TEST mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5000/api/v1/payments/success
STRIPE_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel

# ── Demo admin account (created by prisma/seed.ts) ──────────────────────
ADMIN_EMAIL=admin@devassess.com
ADMIN_PASSWORD=ChangeMe123!
